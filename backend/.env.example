# Required to start the API. Use a dedicated staging database during staging.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Required for resume parsing and structured job-skill suggestions; keep server-side only.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Required for browser requests from a separately hosted frontend in production.
CORS_ORIGINS=http://localhost:5173

# Optional; these are the current defaults.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional. Normally leave DNS to the hosting environment.
# MONGODB_DNS_SERVER=1.1.1.1

# Supplied by most hosts. Local default is 5000.
PORT=5000
NODE_ENV=development
